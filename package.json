{
  "name": "@kek/eyg-json-bridge",
  "version": "0.3.0",
  "description": "Bounded JSON bridge to upstream EYG evaluation and host-defined effects",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kek/eyg-json-bridge.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./worker": "./node/worker.mjs",
    "./input": "./node/input.mjs",
    "./bridge": "./dist/eyg_json_bridge/eyg_json_bridge.mjs"
  },
  "files": [
    "node/",
    "src/",
    "gleam.toml",
    "manifest.toml",
    "dist/",
    "LICENSE",
    "NOTICE",
    "PROTOCOL.md",
    "CHANGELOG.md",
    "docs/MIGRATION.md",
    "docs/BEAM.md"
  ],
  "scripts": {
    "build": "gleam build --target javascript && node scripts/package-runtime.mjs",
    "test": "node --test test/*.test.mjs",
    "test:beam": "sh scripts/test-beam.sh",
    "test:core": "gleam run --target javascript --module portability_test && gleam run --target erlang --module portability_test",
    "prepack": "npm run build",
    "test:package": "node scripts/test-package.mjs"
  }
}
